<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:include filename="inertial_macros.xacro" />
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="gray">
        <color rgba="0.7 0.63 0.66 0"/>
    </material>
    <!--base_link-->
    <link name="base_link">

    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz= "-0.1 0 0"/>
    </joint>
    <!--chassy_link-->
    <link name="chassis">
        <visual>
            <origin xyz="0.15 0 0.08"/>
            <geometry>
                <box size="0.35 0.2 0.13"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.15 0 0.08"/>
            <geometry>
                <box size="0.35 0.2 0.13"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.35" y="0.2" z="0.13">
            <origin xyz="0.15 0 0.08" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo>
    <!--LEFT_FRONT_WHEEL_LINK-->

    <joint name="left_front_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_front_wheel"/>
        <origin xyz="0.155 0.114 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="left_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
        </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.027" radius="0.065">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
    </link>
    <gazebo reference="left_front_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>
    <!--RIGHT_FRONT_WHEEL_LINK-->
    <joint name="right_front_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_front_wheel"/>
        <origin xyz="0.155 -0.114 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>
    <link name="right_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
        </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.027" radius="0.065">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
    </link>
    <gazebo reference="right_front_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>
    <!--LEFT_BACK_WHEEL_LINK-->
    <joint name="left_back_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_back_wheel"/>
        <origin xyz="-0.045 0.114 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="left_back_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
        </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.027" radius="0.065">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
    </link>
    <gazebo reference="left_back_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>
    <!--RIGHT_BACK_WHEEL_LINK-->
    <joint name="right_back_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_back_wheel"/>
        <origin xyz="-0.045 -0.114 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>
    <link name="right_back_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.065" length="0.027"/>
            </geometry>
        </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.027" radius="0.065">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
    </link>
    <gazebo reference="right_back_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>
</robot>